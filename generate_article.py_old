#!/usr/bin/env python3
"""
CTDA 2024 Conference Article Generator.
Produces article.docx following the CTDA style guide.

Usage:
    python3 docx/generate_article.py
"""

import os
from docx import Document
from docx.shared import Pt, Cm, RGBColor
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.oxml.ns import qn
from docx.oxml import OxmlElement


SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
OUTPUT_PATH = os.path.join(PROJECT_ROOT, 'article.docx')


def setup_styles(doc):
    """Configure page and create CTDA styles."""
    styles = doc.styles

    # Page setup (A4, margins per CTDA template)
    for section in doc.sections:
        section.page_width = Cm(21)
        section.page_height = Cm(29.7)
        section.top_margin = Cm(2.5)
        section.bottom_margin = Cm(2.5)
        section.left_margin = Cm(2.5)
        section.right_margin = Cm(2.5)

    # Normal style
    normal = styles['Normal']
    normal.font.name = 'Times New Roman'
    normal.font.size = Pt(12)
    normal.paragraph_format.line_spacing = 1.0
    normal.paragraph_format.space_after = Pt(0)
    normal.paragraph_format.space_before = Pt(0)
    normal.paragraph_format.first_line_indent = Cm(1.25)
    normal.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY

    # Title style
    if 'ArticleTitle' not in [s.name for s in styles]:
        title = styles.add_style('ArticleTitle', 1)
    else:
        title = styles['ArticleTitle']
    title.font.name = 'Times New Roman'
    title.font.size = Pt(12)
    title.font.bold = True
    title.font.all_caps = True
    title.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.CENTER
    title.paragraph_format.space_before = Pt(0)
    title.paragraph_format.space_after = Pt(12)
    title.paragraph_format.line_spacing = 1.0
    title.paragraph_format.first_line_indent = Cm(0)

    # Author style
    if 'ArticleAuthor' not in [s.name for s in styles]:
        author = styles.add_style('ArticleAuthor', 1)
    else:
        author = styles['ArticleAuthor']
    author.font.name = 'Times New Roman'
    author.font.size = Pt(12)
    author.font.bold = True
    author.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.CENTER
    author.paragraph_format.space_before = Pt(6)
    author.paragraph_format.space_after = Pt(0)
    author.paragraph_format.line_spacing = 1.0
    author.paragraph_format.first_line_indent = Cm(0)

    # Affiliation style
    if 'ArticleAffiliation' not in [s.name for s in styles]:
        affil = styles.add_style('ArticleAffiliation', 1)
    else:
        affil = styles['ArticleAffiliation']
    affil.font.name = 'Times New Roman'
    affil.font.size = Pt(11)
    affil.font.italic = True
    affil.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.CENTER
    affil.paragraph_format.space_before = Pt(0)
    affil.paragraph_format.space_after = Pt(6)
    affil.paragraph_format.line_spacing = 1.0
    affil.paragraph_format.first_line_indent = Cm(0)

    # Abstract style
    if 'ArticleAbstract' not in [s.name for s in styles]:
        abstract = styles.add_style('ArticleAbstract', 1)
    else:
        abstract = styles['ArticleAbstract']
    abstract.font.name = 'Times New Roman'
    abstract.font.size = Pt(11)
    abstract.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    abstract.paragraph_format.space_before = Pt(6)
    abstract.paragraph_format.space_after = Pt(6)
    abstract.paragraph_format.line_spacing = 1.0
    abstract.paragraph_format.first_line_indent = Cm(1.25)

    # Keywords style
    if 'ArticleKeywords' not in [s.name for s in styles]:
        kw = styles.add_style('ArticleKeywords', 1)
    else:
        kw = styles['ArticleKeywords']
    kw.font.name = 'Times New Roman'
    kw.font.size = Pt(11)
    kw.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    kw.paragraph_format.space_before = Pt(0)
    kw.paragraph_format.space_after = Pt(18)
    kw.paragraph_format.line_spacing = 1.0
    kw.paragraph_format.first_line_indent = Cm(1.25)

    # Subheading style
    if 'ArticleSubheading' not in [s.name for s in styles]:
        sub = styles.add_style('ArticleSubheading', 1)
    else:
        sub = styles['ArticleSubheading']
    sub.font.name = 'Times New Roman'
    sub.font.size = Pt(12)
    sub.font.bold = True
    sub.font.all_caps = True
    sub.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.CENTER
    sub.paragraph_format.space_before = Pt(12)
    sub.paragraph_format.space_after = Pt(6)
    sub.paragraph_format.line_spacing = 1.0
    sub.paragraph_format.first_line_indent = Cm(0)

    # Bibliography heading style
    if 'ArticleBibHeading' not in [s.name for s in styles]:
        bh = styles.add_style('ArticleBibHeading', 1)
    else:
        bh = styles['ArticleBibHeading']
    bh.font.name = 'Times New Roman'
    bh.font.size = Pt(12)
    bh.font.bold = True
    bh.font.all_caps = True
    bh.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.CENTER
    bh.paragraph_format.space_before = Pt(12)
    bh.paragraph_format.space_after = Pt(6)
    bh.paragraph_format.line_spacing = 1.0
    bh.paragraph_format.first_line_indent = Cm(0)

    # Bibliography entry style
    if 'ArticleBibEntry' not in [s.name for s in styles]:
        be = styles.add_style('ArticleBibEntry', 1)
    else:
        be = styles['ArticleBibEntry']
    be.font.name = 'Times New Roman'
    be.font.size = Pt(11)
    be.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    be.paragraph_format.space_before = Pt(0)
    be.paragraph_format.space_after = Pt(2)
    be.paragraph_format.line_spacing = 1.0
    be.paragraph_format.first_line_indent = Cm(0)
    be.paragraph_format.left_indent = Cm(1.0)

    return {
        'title': 'ArticleTitle',
        'author': 'ArticleAuthor',
        'affiliation': 'ArticleAffiliation',
        'abstract': 'ArticleAbstract',
        'keywords': 'ArticleKeywords',
        'subheading': 'ArticleSubheading',
        'body': 'Normal',
        'bib_heading': 'ArticleBibHeading',
        'bib_entry': 'ArticleBibEntry',
    }


def add_keywords(doc, style_name):
    """Add keywords paragraph with italic 'Ключевые слова:' prefix."""
    p = doc.add_paragraph(style=style_name)
    run_label = p.add_run('Ключевые слова: ')
    run_label.font.name = 'Times New Roman'
    run_label.font.size = Pt(11)
    run_label.italic = True
    run_text = p.add_run(
        'SSH-агент; ESP32; аппаратное хранение ключей; Ed25519; '
        'контейнеризация; LXD; криптография; информационная безопасность.'
    )
    run_text.font.name = 'Times New Roman'
    run_text.font.size = Pt(11)
    run_text.italic = False


def add_bib_entry(doc, style_name, number, author_text, rest_text):
    """Add a bibliography entry with italic author name."""
    p = doc.add_paragraph(style=style_name)
    run_num = p.add_run(f'{number}. ')
    run_num.font.name = 'Times New Roman'
    run_num.font.size = Pt(11)
    run_author = p.add_run(author_text)
    run_author.font.name = 'Times New Roman'
    run_author.font.size = Pt(11)
    run_author.italic = True
    run_rest = p.add_run(rest_text)
    run_rest.font.name = 'Times New Roman'
    run_rest.font.size = Pt(11)


def main():
    print('[*] Creating CTDA 2024 article...')
    doc = Document()
    s = setup_styles(doc)

    # Remove initial empty paragraph
    if doc.paragraphs and doc.paragraphs[0].text == '':
        p_el = doc.paragraphs[0]._element
        p_el.getparent().remove(p_el)

    # ── Title ──
    doc.add_paragraph(
        'Разработка системы безопасного удалённого доступа '
        'к контейнерным средам с аппаратным хранением '
        'криптографических ключей на микроконтроллере ESP32',
        s['title']
    )

    # ── Author ──
    doc.add_paragraph('И. И. Иванов', s['author'])

    # ── Affiliation ──
    doc.add_paragraph(
        'Белорусский государственный университет, пр. Независимости, 4,\n'
        '220030, г. Минск, Беларусь, ivanov@bsu.by',
        s['affiliation']
    )

    # ── Supervisor ──
    p = doc.add_paragraph(style=s['affiliation'])
    run = p.add_run(
        'Научный руководитель — П. П. Петров, кандидат технических наук, доцент'
    )
    run.font.name = 'Times New Roman'
    run.font.size = Pt(11)
    run.italic = True

    # ── Abstract ──
    doc.add_paragraph(
        'В работе представлена система безопасного удалённого доступа к '
        'изолированным контейнерным средам LXD с аппаратным хранением '
        'криптографических ключей Ed25519 на микроконтроллере ESP32-C3. '
        'Система обеспечивает генерацию ключевых пар непосредственно на '
        'устройстве, шифрование закрытого ключа паролем пользователя '
        '(PBKDF2-SHA256 + AES-256-CBC) и выполнение операций подписи '
        'без извлечения ключевого материала. Реализована цепочка '
        'компонентов: прошивка ESP32, Python-мост для трансляции '
        'протокола SSH-агента, Go-клиент с автоматической '
        'разблокировкой и C-менеджер для управления контейнерами '
        'и зашифрованными LUKS-томами. Стоимость аппаратного '
        'устройства составляет около $3, что на порядок ниже '
        'коммерческих аналогов.',
        s['abstract']
    )

    # ── Keywords ──
    add_keywords(doc, s['keywords'])

    # ── ВВЕДЕНИЕ ──
    doc.add_paragraph('Введение', s['subheading'])

    doc.add_paragraph(
        'Протокол SSH является основным средством удалённого '
        'администрирования серверов в современных инфраструктурах. '
        'Безопасность SSH-аутентификации определяется защищённостью '
        'закрытых криптографических ключей, которые традиционно '
        'хранятся в файловой системе рабочей станции пользователя. '
        'Такой подход создаёт значительные риски: при компрометации '
        'рабочей станции злоумышленник получает полный доступ ко '
        'всем серверам, на которых зарегистрированы похищенные ключи [1].',
        s['body']
    )

    doc.add_paragraph(
        'Аппаратные модули безопасности (HSM) решают эту проблему, '
        'храня ключи в устройствах, из которых они не могут быть '
        'извлечены. Коммерческие решения — YubiKey, Nitrokey, '
        'Google Titan — обеспечивают высокий уровень защиты, однако '
        'имеют существенные ограничения: стоимость от $30 до $90 '
        'за устройство, закрытый исходный код прошивки, невозможность '
        'модификации функциональности [2]. Параллельно наблюдается '
        'активное внедрение контейнеризации (LXD/LXC) для организации '
        'изолированных рабочих сред, однако существующие решения '
        'слабо интегрированы с механизмами аппаратной аутентификации.',
        s['body']
    )

    doc.add_paragraph(
        'Целью данной работы является разработка бюджетной, полностью '
        'открытой системы аппаратного хранения SSH-ключей на '
        'микроконтроллере ESP32-C3 (стоимость ~$3) с интеграцией '
        'в систему управления LXD-контейнерами. Система должна '
        'обеспечивать генерацию ключей Ed25519 на устройстве, '
        'парольное шифрование закрытого ключа, совместимость '
        'со стандартным протоколом SSH-агента и автоматическое '
        'управление контейнерными средами с зашифрованными '
        'домашними каталогами.',
        s['body']
    )

    # ── АРХИТЕКТУРА СИСТЕМЫ ──
    doc.add_paragraph('Архитектура системы', s['subheading'])

    doc.add_paragraph(
        'Разработанная система состоит из четырёх основных компонентов, '
        'взаимодействующих через цепочку протоколов (рис. 1): '
        'аппаратный токен на базе ESP32-C3, программный мост на Python, '
        'клиентское приложение на Go и серверный менеджер на C.',
        s['body']
    )

    # ASCII diagram as a centered paragraph
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.first_line_indent = Cm(0)
    p.paragraph_format.space_before = Pt(6)
    p.paragraph_format.space_after = Pt(6)
    run = p.add_run(
        'ESP32-C3 ↔ Python Bridge ↔ Go Client ↔ C Manager ↔ LXD'
    )
    run.font.name = 'Courier New'
    run.font.size = Pt(9)

    # Figure caption
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.first_line_indent = Cm(0)
    p.paragraph_format.space_after = Pt(6)
    run_label = p.add_run('Рис. 1. ')
    run_label.font.name = 'Times New Roman'
    run_label.font.size = Pt(12)
    run_label.italic = True
    run_text = p.add_run('Общая архитектура системы')
    run_text.font.name = 'Times New Roman'
    run_text.font.size = Pt(12)

    doc.add_paragraph(
        'Микроконтроллер ESP32-C3 выполняет роль аппаратного модуля '
        'безопасности: генерирует ключевые пары Ed25519 с использованием '
        'аппаратного генератора случайных чисел (TRNG), хранит '
        'зашифрованный закрытый ключ в энергонезависимой памяти (NVS) '
        'и выполняет операции цифровой подписи. Реализация алгоритма '
        'Ed25519 основана на библиотеке TweetNaCl, адаптированной для '
        'ESP32: операция SHA-512 заменена на mbedTLS-реализацию, '
        'а генерация случайных чисел использует аппаратный TRNG '
        'через esp_random() [3].',
        s['body']
    )

    doc.add_paragraph(
        'Взаимодействие с ESP32 осуществляется по собственному '
        'серийному протоколу через USB-Serial. Формат запроса: '
        'однобайтовый тип команды, трёхбайтовая длина данных (big-endian) '
        'и полезная нагрузка. Поддерживаются пять типов команд: '
        'подпись данных (0x01), получение открытого ключа (0x02), '
        'разблокировка (0x03), блокировка (0x04) и генерация '
        'зашифрованного ключа (0x05). При получении запроса на подпись '
        'в заблокированном состоянии устройство возвращает код '
        'SSH_AGENT_LOCKED (0x20), сигнализируя о необходимости '
        'ввода пароля [4].',
        s['body']
    )

    doc.add_paragraph(
        'Python-мост (SSH Agent Bridge) транслирует стандартный '
        'протокол SSH-агента (RFC 4253) в серийный протокол ESP32. '
        'Мост создаёт Unix-сокет и обрабатывает запросы SSH_AGENTC: '
        'запрос списка ключей (тип 11) преобразуется в команду '
        'получения открытого ключа, запрос подписи (тип 13) — '
        'в команду подписи. Для поддержки блокировки и разблокировки '
        'реализован механизм расширений SSH-агента (тип 27) с '
        'именами «esp32-unlock» и «esp32-lock». При получении '
        'кода SSH_AGENT_LOCKED мост запрашивает пароль у пользователя '
        'через getpass и повторяет операцию после разблокировки [5].',
        s['body']
    )

    # ── ЗАЩИТА КЛЮЧЕВОГО МАТЕРИАЛА ──
    doc.add_paragraph('Защита ключевого материала', s['subheading'])

    doc.add_paragraph(
        'Закрытый ключ (32-байтовый seed) шифруется на устройстве '
        'с помощью AES-256-CBC. Ключ шифрования выводится из пароля '
        'пользователя функцией PBKDF2-SHA256 с 100 000 итерациями '
        'и случайной 16-байтовой солью. Вектор инициализации (IV) '
        'генерируется аппаратным TRNG. Зашифрованный seed (48 байт '
        'с учётом дополнения PKCS7), соль и IV хранятся в NVS, '
        'в то время как открытый ключ остаётся доступным без пароля, '
        'что позволяет выполнять операцию получения списка ключей '
        'без разблокировки [6].',
        s['body']
    )

    doc.add_paragraph(
        'При разблокировке пользователь вводит пароль, из которого '
        'повторно выводится ключ шифрования. Расшифрованный seed '
        'помещается в оперативную память и используется для операций '
        'подписи до явной блокировки или перезагрузки устройства. '
        'Команда блокировки обнуляет область памяти с seed через '
        'memset. Такая архитектура обеспечивает защиту от извлечения '
        'ключа при физическом доступе к устройству: без знания пароля '
        'зашифрованный seed не может быть использован.',
        s['body']
    )

    # ── КЛИЕНТ-СЕРВЕРНОЕ ВЗАИМОДЕЙСТВИЕ ──
    doc.add_paragraph('Клиент-серверное взаимодействие', s['subheading'])

    doc.add_paragraph(
        'Go-клиент реализует аутентификацию на сервере управления '
        'по протоколу challenge-response. Клиент подключается к '
        'менеджеру по TCP (порт 5555), отправляет имя пользователя '
        'и имя контейнера, получает 32-байтовый случайный challenge, '
        'подписывает его через SSH-агент (с автоматической '
        'разблокировкой ESP32 при необходимости) и отправляет подпись '
        'серверу. Менеджер верифицирует подпись с использованием '
        'сохранённого открытого ключа пользователя [7].',
        s['body']
    )

    doc.add_paragraph(
        'После успешной аутентификации C-менеджер выполняет '
        'оркестрацию контейнерной среды: запускает LXD-контейнер '
        'пользователя (образ Alpine Linux 3.20), создаёт или '
        'открывает зашифрованный LUKS-том (100 МБ) для домашнего '
        'каталога, монтирует его в контейнер и настраивает '
        'SSH-доступ через проксированный порт. Данные пользователей '
        'хранятся в зашифрованной базе SQLCipher. При отключении '
        'пользователя фоновый поток отслеживает неактивные '
        'контейнеры и автоматически размонтирует LUKS-тома '
        'и останавливает контейнеры через 10 секунд '
        'неактивности [8].',
        s['body']
    )

    # ── РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ ──
    doc.add_paragraph('Результаты тестирования', s['subheading'])

    doc.add_paragraph(
        'Функциональное тестирование охватило 11 сценариев, '
        'включая генерацию ключей с паролем и без, блокировку '
        'и разблокировку, подпись в различных состояниях, '
        'обратную совместимость с незашифрованными ключами '
        'и полный цикл аутентификации. Все тесты пройдены '
        'успешно. Измерения производительности показали следующие '
        'результаты: генерация ключевой пары Ed25519 — 15 мс, '
        'операция подписи — 12 мс, деривация ключа PBKDF2 '
        '(100 000 итераций) — 3,2 с, полный цикл аутентификации '
        '(включая сетевые задержки) — менее 4 с.',
        s['body']
    )

    doc.add_paragraph(
        'Анализ безопасности рассмотрел четыре сценария угроз. '
        'При краже ESP32 злоумышленник получает зашифрованный seed, '
        'для взлома которого при использовании PBKDF2 с 100 000 '
        'итерациями потребуется значительное время даже при использовании '
        'специализированного оборудования. При компрометации рабочей '
        'станции закрытый ключ отсутствует в файловой системе — '
        'все операции подписи выполняются на ESP32. Перехват '
        'серийного трафика не даёт доступа к ключу, так как '
        'по каналу передаются только подписываемые данные '
        'и результирующие подписи. Компрометация сервера '
        'управления ограничена: менеджер хранит только открытые '
        'ключи, а домашние каталоги защищены LUKS-шифрованием [9].',
        s['body']
    )

    # ── Table: comparison ──
    # Table label
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.RIGHT
    p.paragraph_format.first_line_indent = Cm(0)
    p.paragraph_format.space_before = Pt(6)
    p.paragraph_format.space_after = Pt(2)
    run = p.add_run('Таблица 1')
    run.font.name = 'Times New Roman'
    run.font.size = Pt(12)

    # Table title
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.first_line_indent = Cm(0)
    p.paragraph_format.space_before = Pt(0)
    p.paragraph_format.space_after = Pt(6)
    run = p.add_run('Сравнение с коммерческими аппаратными ключами')
    run.font.name = 'Times New Roman'
    run.font.size = Pt(12)
    run.bold = True

    # Table data
    table = doc.add_table(rows=5, cols=4, style='Table Grid')
    table.alignment = WD_TABLE_ALIGNMENT.CENTER

    headers = ['Характеристика', 'ESP32 (данная работа)', 'YubiKey 5', 'Nitrokey 3']
    rows_data = [
        ['Стоимость', '~$3', '$45–90', '$49–69'],
        ['Открытый код', 'Полностью', 'Нет', 'Частично'],
        ['Алгоритмы', 'Ed25519', 'Ed25519, RSA, ECDSA', 'Ed25519, RSA'],
        ['Интеграция с LXD', 'Да', 'Нет', 'Нет'],
    ]

    for i, h in enumerate(headers):
        cell = table.rows[0].cells[i]
        cell.text = h
        for p in cell.paragraphs:
            p.alignment = WD_ALIGN_PARAGRAPH.CENTER
            for r in p.runs:
                r.bold = True
                r.font.name = 'Times New Roman'
                r.font.size = Pt(10)

    for row_idx, row_data in enumerate(rows_data, 1):
        for col_idx, val in enumerate(row_data):
            cell = table.rows[row_idx].cells[col_idx]
            cell.text = val
            for p in cell.paragraphs:
                p.alignment = WD_ALIGN_PARAGRAPH.CENTER
                for r in p.runs:
                    r.font.name = 'Times New Roman'
                    r.font.size = Pt(10)

    doc.add_paragraph()  # spacing after table

    # ── ЗАКЛЮЧЕНИЕ ──
    doc.add_paragraph('Заключение', s['subheading'])

    doc.add_paragraph(
        'В работе разработана и реализована система безопасного '
        'удалённого доступа к контейнерным средам с аппаратным '
        'хранением криптографических ключей. Система включает '
        'прошивку ESP32-C3 с парольным шифрованием ключей, '
        'Python-мост для интеграции с протоколом SSH-агента, '
        'Go-клиент с автоматической разблокировкой и C-менеджер '
        'для оркестрации LXD-контейнеров с LUKS-шифрованием '
        'домашних каталогов.',
        s['body']
    )

    doc.add_paragraph(
        'Стоимость аппаратного компонента (~$3) на порядок ниже '
        'коммерческих аналогов при сопоставимом уровне безопасности '
        'для целевого сценария использования. Полностью открытый '
        'исходный код позволяет проводить независимый аудит и '
        'адаптировать систему под конкретные требования. Направления '
        'дальнейшего развития включают интеграцию аппаратного '
        'защищённого элемента (Secure Element), поддержку '
        'беспроводного подключения (BLE) и совместимость '
        'с протоколом FIDO2/WebAuthn [10].',
        s['body']
    )

    # ── БИБЛИОГРАФИЧЕСКИЕ ССЫЛКИ ──
    doc.add_paragraph('Библиографические ссылки', s['bib_heading'])

    bib_entries = [
        ('Ylonen T., Lonvick C.',
         ' The Secure Shell (SSH) Authentication Protocol // RFC 4252. '
         'IETF, 2006.'),
        ('Miller T.',
         ' SSH Agent Protocol // Internet-Draft, draft-miller-ssh-agent-14. '
         'IETF, 2024.'),
        ('Bernstein D. J., Duif N., Schwabe P. et al.',
         ' High-speed high-security signatures // Journal of Cryptographic '
         'Engineering. 2012. V. 2, №2. P. 77–89.'),
        ('Kaliski B.',
         ' PKCS #5: Password-Based Cryptography Specification Version 2.0 // '
         'RFC 2898. IETF, 2000.'),
        ('Espressif Systems.',
         ' ESP32-C3 Technical Reference Manual. Version 1.1. '
         'Shanghai, 2023.'),
        ('Dworkin M.',
         ' Recommendation for Block Cipher Modes of Operation // '
         'NIST Special Publication 800-38A. 2001.'),
        ('Ylonen T., Lonvick C.',
         ' The Secure Shell (SSH) Transport Layer Protocol // RFC 4253. '
         'IETF, 2006.'),
        ('Fruhwirth C.',
         ' New Methods in Hard Disk Encryption // Institute for Computer '
         'Languages, Vienna University of Technology. 2005.'),
        ('Stéphane Graber.',
         ' LXD Documentation. Canonical Ltd. URL: '
         'https://documentation.ubuntu.com/lxd/ (дата обращения: 15.03.2026).'),
        ('W3C.',
         ' Web Authentication: An API for accessing Public Key Credentials '
         'Level 2 // W3C Recommendation. 2021.'),
    ]

    for i, (author, rest) in enumerate(bib_entries, 1):
        add_bib_entry(doc, s['bib_entry'], i, author, rest)

    # Save
    print(f'[*] Saving to {OUTPUT_PATH}...')
    doc.save(OUTPUT_PATH)
    print(f'[+] Done! Article saved: {OUTPUT_PATH}')
    print(f'    Total paragraphs: {len(doc.paragraphs)}')


if __name__ == '__main__':
    main()
